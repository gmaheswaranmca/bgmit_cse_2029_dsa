instk = empty()
outstk = empty()
Push(x)
    instk.push(x)
Pop()
    if outstk.empty()
        while NOT instk.empty()
            outstk.push(instk.pop())
    return outstk.pop()
Peek()
    if outstk.empty()
        while NOT instk.empty()
            outstk.push(instk.pop())
    return outstk.top()
Empty()
    return instk.empty() AND outstk.empty()